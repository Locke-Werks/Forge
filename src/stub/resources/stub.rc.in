//
// lwforge replaces this version resource when it stamps a product, so what is
// here identifies the stub itself. It exists so an unstamped lwstub.exe is not
// a version-less binary that security tooling flags on sight.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @LWI_VERSION_RC@
PRODUCTVERSION @LWI_VERSION_RC@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
