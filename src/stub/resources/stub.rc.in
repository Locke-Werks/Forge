        BEGIN
            VALUE "CompanyName",      "@LWI_COMPANY@"
            VALUE "FileDescription",  "Locke Werks Installer Stub"
            VALUE "FileVersion",      "@LWI_VERSION_RC_STR@"
            VALUE "InternalName",     "lwstub"
            VALUE "LegalCopyright",   "@LWI_COPYRIGHT@"
            VALUE "OriginalFilename", "lwstub.exe"
            VALUE "ProductName",      "lwi"
            VALUE "ProductVersion",   "@LWI_VERSION_RC_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
