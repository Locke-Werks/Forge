* text=auto eol=lf

*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Test fixtures are byte-exact PE images. Any normalisation corrupts them and
# the PE layout tests then fail for a reason that looks like a parser bug.
tests/fixtures/** binary
assets/*.png      binary
assets/*.ico      binary
